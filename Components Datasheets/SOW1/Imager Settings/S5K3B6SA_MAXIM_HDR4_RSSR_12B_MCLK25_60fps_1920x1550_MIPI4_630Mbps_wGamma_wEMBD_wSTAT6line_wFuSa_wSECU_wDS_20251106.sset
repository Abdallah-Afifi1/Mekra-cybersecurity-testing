//$MV4[MCLK:25.0,mipi_phy_type:Dphy,mipi_lane:4,mipi_datarate:630]
//$MV4_CPHY_LRTE[enable:0,longPacketSpace:5,shortPacketSpace:5]
//$MV4_Scramble[enable:0]
//$MV4_MainData[width:1920,height:1550,data_type:MIPI_RAW12 (0x2C),virtual_channel:0]
//$MV4_InterleavedData[isUsed:0,width:0,height:0,data_type:User_Defined_1 (0x30),virtual_channel:1]
//$MV4_InterleavedData[isUsed:0,width:0,height:0,data_type:User_Defined_1 (0x30),virtual_channel:1]
//$MV4_InterleavedData[isUsed:0,width:0,height:0,data_type:User_Defined_1 (0x30),virtual_channel:1]
//$MV4_Start[]


p50

//Ser Device Address : 0x80 Pipe Y
//Des Device Address : 0x90

// Serializer/Deserializer GMSL link reset.
I2C [90]
I2C 001031 //one shot reset

I2C [80]
I2C 033000 //don't care always 1x4
I2C 0332E4 // Straight mapping
I2C 0333E4 // Straight mapping
I2C 033130 // 4-lane
I2C 0311F0 // Port B start
//I2C 030862 //Port B to pipe Y 0x64(pipe Z)
I2C 030864

p100
I2C 0314A2 // VS_VC_Check
//I2C 03166C // Pipe Y RAW12 filter 0x318 = 0x6C
I2C 03186C
//I2C 000223 // VID_TX_EN from Pipe Y 0x43 for using pipe Z
I2C 000243 
p100

I2C [90]
I2C 033004 //2x4 mode
I2C 03334E // straight mapping
I2C 0334E4 // straight mapping
p100
I2C 040A00 
I2C 044AD0 // 4-lane Port A
I2C 048AD0 // 4-lane port B
I2C 04CA00
p100
I2C 031D2F //
I2C 03202C //1.2Gbps MIPI Data
I2C 03232F //1.5Gbps MIPI Data
I2C 03262F
p100
I2C 005001 // X from Y 
I2C 005102 // Y from Z
I2C 005202 // Z from Z
I2C 005303 // U from U
I2C 0332F0
p100

I2C [80]
I2C 02be80 //GPIO0 low
p100
I2C 02be90 // GPIO0 high
p1000
p15	

