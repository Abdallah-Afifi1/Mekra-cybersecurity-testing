{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run HIL test (current file)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Python/TestPool"
      }
    }
  ]
}