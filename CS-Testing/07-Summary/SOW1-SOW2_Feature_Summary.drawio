<mxfile host="app.diagrams.net"><diagram name="1 Message flow" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1c3" value="SOW1 - SOW2 secure communication: message flow" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p1c4" value="SOW2 (ECU, CV22FS) authenticates the camera head (SOW1, imager S5K3B6SA), then protects every frame and command" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="1800" height="36" as="geometry"/></mxCell><mxCell id="p1c5" value="&lt;b&gt;SOW1 - Camera head&lt;/b&gt;&lt;br&gt;imager + OTP key pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="400" height="90" as="geometry"/></mxCell><mxCell id="p1c6" value="&lt;b&gt;SOW2 - ECU (SoC)&lt;/b&gt;&lt;br&gt;Root public key in OTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="400" height="90" as="geometry"/></mxCell><mxCell id="p1c7" value="" style="html=1;strokeColor=#999999;strokeWidth=3;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="220" as="sourcePoint"/><mxPoint x="350" y="1180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c8" value="" style="html=1;strokeColor=#999999;strokeWidth=3;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="220" as="sourcePoint"/><mxPoint x="1450" y="1180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c9" value="1  Read Device_n, KID, Sig_device (I2C)" style="html=1;strokeColor=#2E75B6;strokeWidth=4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="270" as="sourcePoint"/><mxPoint x="1450" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c10" value="2  Verify Sig_device with Samsung Root Public Key (RSASSA-PSS, SHA-256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="870" y="358" width="860" height="64" as="geometry"/></mxCell><mxCell id="p1c11" value="3  Generate 256-bit SSK (CSPRNG seeded by TRNG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="870" y="478" width="860" height="64" as="geometry"/></mxCell><mxCell id="p1c12" value="4  SSK + Row_info encrypted with device public key (RSAES-OAEP, SHA-256) (I2C)" style="html=1;strokeColor=#C55A11;strokeWidth=4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="630" as="sourcePoint"/><mxPoint x="350" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c13" value="5  Frame + 128-bit AES-CMAC tag + frame counter (MIPI over GMSL2)" style="html=1;strokeColor=#2E75B6;strokeWidth=4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="770" as="sourcePoint"/><mxPoint x="1450" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c14" value="6  Recompute CMAC, compare, check 3-frame freshness window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="870" y="858" width="860" height="64" as="geometry"/></mxCell><mxCell id="p1c15" value="7  Commands with CMAC + counter (I2C)" style="html=1;strokeColor=#C55A11;strokeWidth=4;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1450" y="1010" as="sourcePoint"/><mxPoint x="350" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c16" value="8  Failure / reset / expiry: new session; retry on error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="870" y="1088" width="860" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Connections" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2c3" value="SOW2 - SOW1 connections and protocols" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="p2c4" value="Real camera head on the bench; positive flow on the path below" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="1900" height="36" as="geometry"/></mxCell><mxCell id="p2c5" value="&lt;b&gt;SOW1 camera head&lt;/b&gt;&lt;br&gt;Imager S5K3B6SA&lt;br&gt;OTP key pair&lt;br&gt;Serializer MAX96717" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="330" height="300" as="geometry"/></mxCell><mxCell id="p2c6" value="&lt;b&gt;Deserializer&lt;/b&gt;&lt;br&gt;MAX96714F&lt;br&gt;+ dual high-side switch&lt;br&gt;(PoC power)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE9C7;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="340" height="300" as="geometry"/></mxCell><mxCell id="p2c7" value="&lt;b&gt;SOW2 SoC&lt;/b&gt;&lt;br&gt;Ambarella CV22FS&lt;br&gt;OTP root key&lt;br&gt;hardware TRNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1090" y="180" width="330" height="300" as="geometry"/></mxCell><mxCell id="p2c8" value="&lt;b&gt;Vehicle ECU&lt;/b&gt;&lt;br&gt;(Ethernet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1560" y="180" width="300" height="300" as="geometry"/></mxCell><mxCell id="p2c9" value="GMSL2 over coax&lt;br&gt;(Fakra)" style="html=1;strokeColor=#2E75B6;strokeWidth=6;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="330" as="sourcePoint"/><mxPoint x="560" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c10" value="MIPI CSI-2&lt;br&gt;+ Only Main I2C" style="html=1;strokeColor=#2E75B6;strokeWidth=6;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="330" as="sourcePoint"/><mxPoint x="1090" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c11" value="RGMII +&lt;br&gt;MDIO" style="html=1;strokeColor=#7F7F7F;strokeWidth=4;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=21;fontColor=#7F7F7F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="330" as="sourcePoint"/><mxPoint x="1560" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c12" value="&lt;b&gt;GPIO sideband&lt;/b&gt;&lt;br&gt;FSYNC, LH_EN&lt;br&gt;IMG_ERROR_N&lt;br&gt;PMIC_ERROR_N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="560" y="540" width="340" height="200" as="geometry"/></mxCell><mxCell id="p2c13" value="&lt;b&gt;Peripherals&lt;/b&gt;&lt;br&gt;Ethernet PHY TJA1121A/1104A&lt;br&gt;SPI flash, PMIC&lt;br&gt;JTAG (development only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1090" y="540" width="330" height="200" as="geometry"/></mxCell><mxCell id="p2c14" value="&lt;b&gt;Carried over GMSL2&lt;/b&gt;&lt;br&gt;video (MIPI CSI-2 0x2C/0x2E)&lt;br&gt;I2C control&lt;br&gt;GPIO, PoC power" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="330" height="200" as="geometry"/></mxCell><mxCell id="p2c15" value="" style="html=1;strokeColor=#7F7F7F;strokeWidth=4;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#7F7F7F;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="480" as="sourcePoint"/><mxPoint x="730" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c16" value="" style="html=1;strokeColor=#7F7F7F;strokeWidth=4;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#7F7F7F;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="480" as="sourcePoint"/><mxPoint x="1255" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c17" value="MDI 100/1000BASE-T1&lt;br&gt;(HMTD)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1560" y="400" width="300" height="70" as="geometry"/></mxCell><mxCell id="p2c18" value="Security relevant: I2C carries authentication data and commands (CMAC); MIPI carries frames with CMAC tag.&lt;br&gt;JTAG and debug access are development only. Secret key values are visible only through a debugger." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1820" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Review workflow" id="page3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3c3" value="Requirement review workflow" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="p3c4" value="Requirement by requirement; SIQs now, formal review later" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="1900" height="36" as="geometry"/></mxCell><mxCell id="p3c5" value="&lt;b&gt;Requirement&lt;/b&gt;&lt;br&gt;in Polarion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c6" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="245" as="sourcePoint"/><mxPoint x="350" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c7" value="&lt;b&gt;Your opinion&lt;/b&gt;&lt;br&gt;or question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c8" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="245" as="sourcePoint"/><mxPoint x="660" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c9" value="&lt;b&gt;Discussion&lt;/b&gt;&lt;br&gt;valid? answered&lt;br&gt;elsewhere?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE9C7;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c10" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="245" as="sourcePoint"/><mxPoint x="970" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c11" value="&lt;b&gt;SIQ under&lt;/b&gt;&lt;br&gt;category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c12" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="245" as="sourcePoint"/><mxPoint x="1280" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c13" value="&lt;b&gt;SIQ log&lt;/b&gt;&lt;br&gt;Excel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1280" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c14" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="245" as="sourcePoint"/><mxPoint x="1590" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c15" value="&lt;b&gt;Formal review&lt;/b&gt;&lt;br&gt;later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1590" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c16" value="Requirement approval guideline: any HIGH issue = comment and disapprove" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=28;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1820" height="50" as="geometry"/></mxCell><mxCell id="p3c17" value="&lt;b&gt;Testability&lt;/b&gt;&lt;br&gt;HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c18" value="&lt;b&gt;Technical&lt;/b&gt;&lt;br&gt;HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="505" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c19" value="&lt;b&gt;Structure&lt;/b&gt;&lt;br&gt;LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="970" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c20" value="&lt;b&gt;Traceability&lt;/b&gt;&lt;br&gt;LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1435" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c21" value='&lt;b&gt;Agreed rules&lt;/b&gt;&lt;br&gt;- SIQ tagged SWE: when the topic is software scope, not system scope&lt;br&gt;- Use "-" where there is nothing to comment; minor comments go in the Decision note column&lt;br&gt;- A non-testable verification method is not minor: it is a Testability SIQ&lt;br&gt;- Technical, structure and traceability findings are kept for the formal review' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=3;fontSize=24;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Test approach" id="page4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4c3" value="Test approach" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="p4c4" value="Real camera integrated; negative cases by fault injection on SOW2" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="1900" height="36" as="geometry"/></mxCell><mxCell id="p4c5" value="&lt;b&gt;System level&lt;/b&gt;&lt;br&gt;Real SOW1 camera head&lt;br&gt;Positive flow: auth, SSK exchange, tagged frames, commands&lt;br&gt;Observe: Saleae (I2C only), TE-1190 (GMSL / MIPI), Wireshark (Ethernet)&lt;br&gt;No SOW1 simulator needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=26;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="880" height="420" as="geometry"/></mxCell><mxCell id="p4c6" value="&lt;b&gt;Software level&lt;/b&gt;&lt;br&gt;Lauterbach debugger on SOW2&lt;br&gt;Fault injection: wrong signature, wrong tag, old counter,&lt;br&gt;replayed frame, failed decrypt, retry limit, reset / expiry&lt;br&gt;Check the SOW2 reaction: terminate, retry, new session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=26;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="880" height="420" as="geometry"/></mxCell><mxCell id="p4c7" value="&lt;b&gt;Not testable at system level (needs debugger or review of design evidence)&lt;/b&gt;&lt;br&gt;- Secret key values (SSK, root and device private keys)&lt;br&gt;- RNG compliance (CSPRNG seeded by TRNG)&lt;br&gt;- Imager private key (inside the OTP of SOW1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#A94442;strokeWidth=3;fontSize=26;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="260" as="geometry"/></mxCell><mxCell id="p4c8" value="Link: every negative case needs a requirement with a defined, testable verification method" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>