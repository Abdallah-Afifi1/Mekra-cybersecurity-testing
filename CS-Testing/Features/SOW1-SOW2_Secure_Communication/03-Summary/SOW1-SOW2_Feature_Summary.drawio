<mxfile host="app.diagrams.net"><diagram name="1 Message flow" id="page1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="2766" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1c3" value="SOW1 - SOW2 secure communication: request and response" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2120" height="60" as="geometry"/></mxCell><mxCell id="p1c4" value="SOW2 (ECU, I2C master) asks, SOW1 (camera head, I2C slave) answers. Requirement IDs on each step; (n) = open SIQs" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="2120" height="36" as="geometry"/></mxCell><mxCell id="p1c5" value="" style="html=1;strokeColor=#999999;strokeWidth=2;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="210" as="sourcePoint"/><mxPoint x="1150" y="2636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c6" value="" style="html=1;strokeColor=#999999;strokeWidth=2;endArrow=none;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="210" as="sourcePoint"/><mxPoint x="350" y="2636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c7" value="&lt;b&gt;SOW2 - ECU (SoC CV22FS)&lt;/b&gt;&lt;br&gt;I2C master, Root Public Key in OTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="640" height="80" as="geometry"/></mxCell><mxCell id="p1c8" value="&lt;b&gt;SOW1 - Camera head&lt;/b&gt;&lt;br&gt;I2C slave, imager key pair in OTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="600" height="80" as="geometry"/></mxCell><mxCell id="p1c9" value="Requirements (open SIQs)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="560" height="80" as="geometry"/></mxCell><mxCell id="p1c10" value="A  Authenticate the camera head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#7F7F7F;strokeWidth=2;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="2030" height="44" as="geometry"/></mxCell><mxCell id="p1c11" value="REQUEST: read Device_n, KID, Sig_device&lt;br&gt;(I2C read, after reset or before the session)" style="html=1;strokeColor=#C55A11;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="372" as="sourcePoint"/><mxPoint x="1150" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c12" value="MVC-107642 (5 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="338" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c13" value="RESPONSE: Device_n, KID, Sig_device&lt;br&gt;(from the imager OTP)" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="484" as="sourcePoint"/><mxPoint x="350" y="484" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c14" value="MVC-107642 (5 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="450" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c15" value="No or incomplete answer: retry up to 3 times, then terminate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="566" width="760" height="64" as="geometry"/></mxCell><mxCell id="p1c16" value="MVC-103053 (7 SIQ)&lt;br&gt;MVC-103051 (5 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="562" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c17" value="Verify Sig_device with the Samsung Root Public Key&lt;br&gt;(RSASSA-PSS, SHA-256; key in OTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="658" width="640" height="72" as="geometry"/></mxCell><mxCell id="p1c18" value="MVC-107642 (5 SIQ)&lt;br&gt;MVC-107641 (5 SIQ)&lt;br&gt;MVC-103063 (5 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="642" width="560" height="104" as="geometry"/></mxCell><mxCell id="p1c19" value="Extract the device public key from the data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="786" width="640" height="72" as="geometry"/></mxCell><mxCell id="p1c20" value="MVC-103040 (6 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="786" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c21" value="B  Establish the session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#7F7F7F;strokeWidth=2;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="920" width="2030" height="44" as="geometry"/></mxCell><mxCell id="p1c22" value="Generate 256-bit SSK (CSPRNG seeded by TRNG)&lt;br&gt;SSK is never exposed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="998" width="640" height="72" as="geometry"/></mxCell><mxCell id="p1c23" value="MVC-103057 (2 SIQ)&lt;br&gt;MVC-103042 (5 SIQ)&lt;br&gt;MVC-113706 (comment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="982" width="560" height="104" as="geometry"/></mxCell><mxCell id="p1c24" value="Encrypt SSK + Row_info with the device public key&lt;br&gt;(RSAES-OAEP, SHA-256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="1126" width="640" height="72" as="geometry"/></mxCell><mxCell id="p1c25" value="MVC-103055 (2 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1126" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c26" value="REQUEST: write encrypted SSK + Row_info&lt;br&gt;(I2C write)" style="html=1;strokeColor=#C55A11;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1260" as="sourcePoint"/><mxPoint x="1150" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c27" value="MVC-103034 (2 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1226" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c28" value="RESPONSE: expected response (not defined yet)" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="1372" as="sourcePoint"/><mxPoint x="350" y="1372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c29" value="MVC-103046 (3 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1338" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c30" value="No expected response: retry up to 3 times, then terminate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="1454" width="760" height="64" as="geometry"/></mxCell><mxCell id="p1c31" value="MVC-103046 (3 SIQ)&lt;br&gt;MVC-103044 (1 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1450" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c32" value="C  Protected video (SOW1 sends frames on its own after streaming starts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#7F7F7F;strokeWidth=2;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="1580" width="2030" height="44" as="geometry"/></mxCell><mxCell id="p1c33" value="FRAME: counter in header, 128-bit AES-CMAC tag in footer&lt;br&gt;(MIPI CSI-2 over GMSL2)" style="html=1;strokeColor=#548235;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=22;fontColor=#548235;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="1692" as="sourcePoint"/><mxPoint x="350" y="1692" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1c34" value="MVC-103031 (3 SIQ)&lt;br&gt;MVC-113705 (2 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1658" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c35" value="Calculate the tag with the SSK over the selected rows&lt;br&gt;Compare with the received tag; check the 3-frame counter window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="1770" width="640" height="72" as="geometry"/></mxCell><mxCell id="p1c36" value="MVC-103033 (5 SIQ)&lt;br&gt;MVC-119709 (6 SIQ)&lt;br&gt;MVC-113703 (3 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1754" width="560" height="104" as="geometry"/></mxCell><mxCell id="p1c37" value="Pass: trusted frame.  Fail: frame rejected&lt;br&gt;Before authentication and session: never trusted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="1898" width="640" height="72" as="geometry"/></mxCell><mxCell id="p1c38" value="MVC-119710 (3 SIQ)&lt;br&gt;MVC-119708 (2 SIQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="1898" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c39" value="D  Protected commands (SOW2 to SOW1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#7F7F7F;strokeWidth=2;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="2032" width="2030" height="44" as="geometry"/></mxCell><mxCell id="p1c40" value="No control command before successful authentication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="2110" width="640" height="72" as="geometry"/></mxCell><mxCell 