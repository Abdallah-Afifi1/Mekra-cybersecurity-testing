=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="p3c4" value="Requirement by requirement; SIQs now, formal review later" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="1900" height="36" as="geometry"/></mxCell><mxCell id="p3c5" value="&lt;b&gt;Requirement&lt;/b&gt;&lt;br&gt;in Polarion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c6" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="245" as="sourcePoint"/><mxPoint x="350" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c7" value="&lt;b&gt;Your opinion&lt;/b&gt;&lt;br&gt;or question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c8" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="245" as="sourcePoint"/><mxPoint x="660" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c9" value="&lt;b&gt;Discussion&lt;/b&gt;&lt;br&gt;valid? answered&lt;br&gt;elsewhere?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE9C7;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c10" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="245" as="sourcePoint"/><mxPoint x="970" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c11" value="&lt;b&gt;SIQ under&lt;/b&gt;&lt;br&gt;category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c12" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="245" as="sourcePoint"/><mxPoint x="1280" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c13" value="&lt;b&gt;SIQ log&lt;/b&gt;&lt;br&gt;Excel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1280" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c14" value="" style="html=1;strokeColor=#2E75B6;strokeWidth=5;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="245" as="sourcePoint"/><mxPoint x="1590" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3c15" value="&lt;b&gt;Formal review&lt;/b&gt;&lt;br&gt;later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#1F3864;strokeWidth=3;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1590" y="160" width="270" height="170" as="geometry"/></mxCell><mxCell id="p3c16" value="Requirement approval guideline: any HIGH issue = comment and disapprove" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=28;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1820" height="50" as="geometry"/></mxCell><mxCell id="p3c17" value="&lt;b&gt;Testability&lt;/b&gt;&lt;br&gt;HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c18" value="&lt;b&gt;Technical&lt;/b&gt;&lt;br&gt;HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="505" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c19" value="&lt;b&gt;Structure&lt;/b&gt;&lt;br&gt;LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="970" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c20" value="&lt;b&gt;Traceability&lt;/b&gt;&lt;br&gt;LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=30;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1435" y="450" width="420" height="130" as="geometry"/></mxCell><mxCell id="p3c21" value='&lt;b&gt;Agreed rules&lt;/b&gt;&lt;br&gt;- SIQ tagged SWE: when the topic is software scope, not system scope&lt;br&gt;- Use "-" where there is nothing to comment; minor comments go in the Decision note column&lt;br&gt;- A non-testable verification method is not minor: it is a Testability SIQ&lt;br&gt;- Technical, structure and traceability findings are kept for the formal review' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=3;fontSize=24;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Test approach" id="page4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4c3" value="Test approach" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="p4c4" value="Real camera integrated; negative cases by fault injection on SOW2" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="68" width="1900" height="36" as="geometry"/></mxCell><mxCell id="p4c5" value="&lt;b&gt;System level&lt;/b&gt;&lt;br&gt;Real SOW1 camera head&lt;br&gt;Positive flow: auth, SSK exchange, tagged frames, commands&lt;br&gt;Observe: Saleae (I2C only), TE-1190 (GMSL / MIPI), Wireshark (Ethernet)&lt;br&gt;No SOW1 simulator needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=3;fontSize=26;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="880" height="420" as="geometry"/></mxCell><mxCell id="p4c6" value="&lt;b&gt;Software level&lt;/b&gt;&lt;br&gt;Lauterbach debugger on SOW2&lt;br&gt;Fault injection: wrong signature, wrong tag, old counter,&lt;br&gt;replayed frame, failed decrypt, retry limit, reset / expiry&lt;br&gt;Check the SOW2 reaction: terminate, retry, new session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#1F3864;strokeWidth=3;fontSize=26;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="880" height="420" as="geometry"/></mxCell><mxCell id="p4c7" value="&lt;b&gt;Not testable at system level (needs debugger or review of design evidence)&lt;/b&gt;&lt;br&gt;- Secret key values (SSK, root and device private keys)&lt;br&gt;- RNG compliance (CSPRNG seeded by TRNG)&lt;br&gt;- Imager private key (inside the OTP of SOW1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#A94442;strokeWidth=3;fontSize=26;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="260" as="geometry"/></mxCell><mxCell id="p4c8" value="Link: every negative case needs a requirement with a defined, testable verification method" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=24;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>