ontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="2484" width="2030" height="44" as="geometry"/></mxCell><mxCell id="p1c47" value="Required after session expiry, system reset, system restart, session termination or a security failure: full authentication and a new SSK, back to step A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7DA;strokeColor=#A94442;strokeWidth=2;fontSize=21;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="2562" width="1440" height="72" as="geometry"/></mxCell><mxCell id="p1c48" value="MVC-103036 (4 SIQ + comment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1500" y="2562" width="560" height="72" as="geometry"/></mxCell><mxCell id="p1c49" value="Arrows: orange = request from SOW2, blue = response from SOW1, green = SOW1 sends on its own. Grey box = SOW2 internal step." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="2696" width="2030" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Connections" id="page2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2c3" value="SOW2 - SOW1 connections and protocols" style="text;html=1;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1900" height="60" as="geometry"/></mxCell><mxCell id="p2c4" value="Real camera head on the bench; positive flow on the path below" style="text;html=1;align=cent