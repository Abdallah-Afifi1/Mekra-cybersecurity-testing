t x="370" y="330" as="sourcePoint"/><mxPoint x="560" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c10" value="MIPI CSI-2&lt;br&gt;+ Only Main I2C" style="html=1;strokeColor=#2E75B6;strokeWidth=6;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=21;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="330" as="sourcePoint"/><mxPoint x="1090" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c11" value="RGMII +&lt;br&gt;MDIO" style="html=1;strokeColor=#7F7F7F;strokeWidth=4;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=21;fontColor=#7F7F7F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="330" as="sourcePoint"/><mxPoint x="1560" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2c12" value="&lt;b&gt;GPIO sideband&lt;/b&gt;&lt;br&gt;FSYNC, LH_EN&lt;br&gt;IMG_ERROR_N&lt;br&gt;PMIC_ERROR_N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="560" y="540" width="340" height="200" as="geometry"/></mxCell><mxCell id="p2c13" value="&lt;b&gt;Peripherals&lt;/b&gt;&lt;br&gt;Ethernet PHY TJA1121A/1104A&lt;br&gt;SPI flash, PMIC&lt;br&gt;JTAG (development only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#7F7F7F;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1090" y="540" width="330" height="200" as="geometry"/></mxCell><mxCell id="p2c14" value="&lt;b&gt;Carried over GMSL2&lt;/b&gt;&lt;br&gt;video (MIPI CSI-2 0x2C/0x2E)&lt;br&gt;I2C control&lt;br&gt;GPIO, PoC power" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=3;fontSize=22;fontColor=#222222;align=center;verticalAlign=mid