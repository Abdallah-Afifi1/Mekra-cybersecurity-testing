l=1;fontSize=12;fontColor=#548235;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="340" as="sourcePoint"/><mxPoint x="1135" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;SOW1 simulator (SIM)&lt;/b&gt;&lt;br&gt;replaces the camera: device private key, test root key, frames with good or bad CMAC and counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="200" height="110" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;strokeColor=#C55A11;strokeWidth=2;endArrow=none;endFill=1;fontSize=12;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="340" as="sourcePoint"/><mxPoint x="140" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Python reference (PyRef)&lt;/b&gt;&lt;br&gt;CMAC, RSA-PSS, RSA-OAEP reference values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="270" height="70" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Test root key + provisioning&lt;/b&gt;&lt;br&gt;Samsung root private key is not available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="300" height="70" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;UART host tool&lt;/b&gt;&lt;br&gt;secure-debug unlock service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="670" y="520" width="240" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;iTestStudio framework&lt;/b&gt;&lt;br&gt;existing Python test pool, reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="940" y="520" width="270" height="70" as="geometry"/></mxCell><mxCell id="c29" value="" style="html=1;strokeColor=#999999;strokeWidth=2;endArrow=none;endFill=1;fontSize=12;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="450" as="sourcePoint"/><mxPoint x="175" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value='Test idea, e.g. for MVC-119709: SIM sends a frame with one bit of the tag flipped; Wireshark shows the frame missing from the RTP stream; the UART log shows "CMAC failed"; Lauterbach reads the dropped-frame counter.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1170" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>