<mxfile host="app.diagrams.net" type="device"><diagram name="1 Message flow" id="1_Message_flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="SOW1 - SOW2 secure communication: message flow" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="10" width="750" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Requirement IDs in brackets are the concept requirements (MVC-...) that cover each step" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="48" width="750" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;SOW1 (camera head)&lt;/b&gt;&lt;br&gt;Samsung S5K3B6SA imager + EEPROM&lt;br&gt;OTP: device RSA key pair, Device ID,&lt;br&gt;Sig_device (signed by Samsung)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="340" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;SOW2 (MEKRA Vision Controller)&lt;/b&gt;&lt;br&gt;SoC CV22FS&lt;br&gt;OTP: Samsung Root Public Key (RSA-2048)&lt;br&gt;[MVC-103063]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="340" height="95" as="geometry"/></mxCell><mxCell id="c7" value="" style="html=1;strokeColor=#999999;strokeWidth=2;endArrow=none;endFill=1;fontSize=12;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="185" as="sourcePoint"/><mxPoint x="220" y="1075" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="" style="html=1;strokeColor=#999999;strokeWidth=2;endArrow=none;endFill=1;fontSize=12;fontColor=#999999;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="185" as="sourcePoint"/><mxPoint x="1030" y="1075" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Read Device_n, KID, Sig_device (I2C)&lt;/b&gt;&lt;br&gt;after reset  [107642]" style="html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="260" as="sourcePoint"/><mxPoint x="220" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="245" width="30" height="30" as="geometry"/></mxCell><mxCell id="c11" value="Verify Sig_device with the Root key&lt;br&gt;RSASSA-PSS + SHA-256, 3 retries&lt;br&gt;[107641, 103053, 103051]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="740" y="300" width="330" height="66" as="geometry"/></mxCell><mxCell id="c12" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="30" height="30" as="geometry"/></mxCell><mxCell id="c13" value="Generate random 256-bit SSK&lt;br&gt;CSPRNG seeded by the hardware TRNG&lt;br&gt;[103057, 103042]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="740" y="385" width="330" height="66" as="geometry"/></mxCell><mxCell id="c14" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="403" width="30" height="30" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;SSK + Row_info, encrypted with the device public key&lt;/b&gt;&lt;br&gt;RSAES-OAEP + SHA-256, over I2C  [103055, 103034, 103040]" style="html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="520" as="sourcePoint"/><mxPoint x="220" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="505" width="30" height="30" as="geometry"/></mxCell><mxCell id="c17" value="Imager decrypts with its private key&lt;br&gt;and computes an AES-CMAC per frame&lt;br&gt;over the selected rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="560" width="300" height="66" as="geometry"/></mxCell><mxCell id="c18" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="578" width="30" height="30" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Video frame + AES-CMAC tag in the footer + frame counter&lt;/b&gt;&lt;br&gt;MIPI over GMSL  [113705, 103031]" style="html=1;strokeColor=#00803F;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#00803F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="700" as="sourcePoint"/><mxPoint x="1030" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="685" width="30" height="30" as="geometry"/></mxCell><mxCell id="c21" value="Recalculate the CMAC and compare  [119709]&lt;br&gt;Counter window: Last &amp;lt; N &amp;lt;= Last+3  [113703]&lt;br&gt;Reject bad frames  [119710]&lt;br&gt;No trust before the session  [119708]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="690" y="740" width="380" height="86" as="geometry"/></mxCell><mxCell id="c22" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="768" width="30" height="30" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Control command + AES-CMAC + counter&lt;/b&gt;&lt;br&gt;only after authentication  [119714, 113701, 119707, 113702]" style="html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#2E75B6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="900" as="sourcePoint"/><mxPoint x="220" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="885" width="30" height="30" as="geometry"/></mxCell><mxCell id="c25" value="Does the imager check the tag? To confirm:&lt;br&gt;not in the Volvo spec; SRS says only&lt;br&gt;when supported by SOW1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="180" y="940" width="330" height="66" as="geometry"/></mxCell><mxCell id="c26" value="?" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="958" width="30" height="30" as="geometry"/></mxCell><mxCell id="c27" value="New session (new authentication, new SSK) after reset, expiry, termination or a security failure  [103036]&lt;br&gt;The SSK must never be exposed through any interface  [113706]&lt;br&gt;The first 17 frames carry no CMAC tag (Volvo spec, section 11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="1130" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Test bench (proposed)" id="2_Test_bench_(proposed)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Proposed cybersecurity test bench for the SOW1 - SOW2 feature" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=20;fontColor=#1F3864;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="10" width="750" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Blue = on the product, green = existing bench equipment, orange = still to build or obtain" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="48" width="750" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Imager + EEPROM&lt;/b&gt;&lt;br&gt;S5K3B6SA&lt;br&gt;(SOW1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Serializer&lt;/b&gt;&lt;br&gt;MAX96717" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Deserializer&lt;/b&gt;&lt;br&gt;MAX96714" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SoC CV22FS&lt;/b&gt;&lt;br&gt;SOW2 software&lt;br&gt;OTP: Root key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ethernet PHY&lt;/b&gt;&lt;br&gt;TJA1104A / TJA1121A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F3864;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="150" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=none;endFill=1;fontSize=12;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="